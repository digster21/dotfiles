#!/usr/bin/env sh

[ -n "$SHELLRC_GUARD" ] && return
SHELLRC_GUARD=1

# Add ~/bin to path so helper scripts can be found.
BIN_HOME = "$HOME/bin"
case ":$PATH:" in
    *":$BIN_HOME:"*) ;;
    *) export PATH="$BIN_HOME:$PATH" ;;
esac

# Add Editor preference
if command -v nvim >/dev/null 2>&1; then
    EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
    EDITOR=vim
else
    EDITOR=vi
fi
export EDITOR

# Add Pager preference
if command -v less >/dev/null 2>&1; then
    export LESS='-F -X -R'
    PAGER=less
else
    PAGER=more
fi
export PAGER

# Configure history
HISTSIZE=3000
HISTFILESIZE=3000
HISTCONTROL=ignoreboth

if [ -n "$BASH_VERSION" ]; then
    shopt -s histappend
fi

if [ -n "$ZSH_VERSION" ]; then
    setopt APPEND_HISTORY
fi

# Node provider: fnm
FNM_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"
if ! command -v fnm >/dev/null 2>&1 && [ ! -x "$FNM_DIR/fnm" ]; then
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "$FNM_DIR" --skip-shell
fi
PATH="$(add-path "$FNM_DIR")"
if command -v fnm >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then _fnm_shell=zsh; else _fnm_shell=bash; fi
    eval "$(fnm env --use-on-cd --version-file-strategy=recursive --corepack-enabled --shell "$_fnm_shell")"
    unset _fnm_shell

    if ! fnm list 2>/dev/null | grep -q default; then
        fnm install --lts
        fnm default lts-latest
    fi
fi

PATH="$(add-path        \
    "$HOME/.local/bin"  \
    "$HOME/.fzf/bin"    \
)"

export PATH
